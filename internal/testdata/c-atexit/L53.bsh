// crt_atexit.c
#include <stdlib.h>
#include <stdio.h>

static void fn1( void ), fn2( void ), fn3( void ), fn4( void );

static int orig_main(void)
{
   atexit( fn1 );
   atexit( fn2 );
   atexit( fn3 );
   atexit( fn4 );
   printf( "This is executed first.\n" );
    return 0;
}

static void fn1()
{
   printf( "next.\n" );
}

static void fn2()
{
   printf( "executed " );
}

static void fn3()
{
   printf( "is " );
}

static void fn4()
{
   printf( "This " );
}
int example_main(void) {
    return orig_main();
}
