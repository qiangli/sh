// basic_ifstream_class.cpp
// compile with: /EHsc

#include <fstream>
#include <iostream>
namespace {

using namespace std;

int orig_main(int argc, char **argv)
{
    ifstream ifs("basic_ifstream_class.txt");
    if (!ifs.bad())
    {
        // Dump the contents of the file to cout.
        cout << ifs.rdbuf();
        ifs.close();
    }
    return 0;
}
}
int example_main() {
    char *argv[] = {(char *)"example", 0};
    return orig_main(1, argv);
}
