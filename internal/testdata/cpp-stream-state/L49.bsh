#include <fstream>
#include <iostream>
namespace {
using namespace std;

int orig_main() {
    ifstream infile("existingtextfile.txt");

    if (!infile.bad())
    {
        // Dump the contents of the file to cout.
        cout << infile.rdbuf();infile.close();
    }
    return 0;
}
}
int example_main() {
    return orig_main();
}
