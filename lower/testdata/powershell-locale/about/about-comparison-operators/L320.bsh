#!/usr/bin/env -S bashy --bashsharp
# powershell-by-example: reference/7.6/Microsoft.PowerShell.Core/About/about_Comparison_Operators.md#L320
# upstream MicrosoftDocs/PowerShell-Docs @ a3de8f22552170e70852470d46cd52cd9ca471ec (code: MIT); generated by tools/fence-corpus/powershell/generate.py; do not edit

~~~powershell as ps
function Example {
& {
# Date comparison
[datetime]'2001-11-12' -lt [datetime]'2020-08-01' # True

# Sorting order comparison
'a' -lt 'z'           # True; 'a' comes before 'z'
'macOS' -ilt 'MacOS'  # False
'MacOS' -ilt 'macOS'  # False
'macOS' -clt 'MacOS'  # True; 'm' comes before 'M'
} *>&1 | Out-String -Stream -Width 120
}
~~~

ps.Example
exit $?
